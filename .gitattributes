# Keep LF line endings in the repository and in checkouts, even on Windows (core.autocrlf=true).
# Shell scripts with CRLF fail inside Linux containers ("exec ./docker-entrypoint.sh: no such file or directory").
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.woff2 binary
*.png binary
*.jpg binary
