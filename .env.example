# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
APP_ENV=development
# Used by the backend outside Docker (docker-compose overrides it):
DATABASE_URL=postgresql+psycopg://azeroth:azeroth@localhost:5432/azeroth
POSTGRES_USER=azeroth
POSTGRES_PASSWORD=azeroth
POSTGRES_DB=azeroth

# Browser-facing URLs. The web app proxies /api to the backend, so both share one origin.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api
ALLOWED_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false

# Fernet key for encrypting Battle.net tokens at rest. REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- Demo ---
# true: seed + expose the fictional demo group and "Explore the demo" login. Purge with:
#   python -m app.cli purge-demo
DEMO_MODE=true

# --- Battle.net (https://develop.battle.net/access/clients) ---
# mock = fixture-backed simulation (no credentials needed); live = real Battle.net API.
BLIZZARD_ADAPTER=mock
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_DEFAULT_REGION=us
BLIZZARD_LOCALE=en_US

# --- Worker / uploads ---
SYNC_INTERVAL_MINUTES=360
MAX_UPLOAD_BYTES=8388608
